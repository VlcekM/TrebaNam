# Skopiruj na .env vedla docker-compose.yml a vypln.

# Heslo pre Postgres v kontajneri db; app ho dostane v connection stringu.
POSTGRES_PASSWORD=zmen-ma

# Google OAuth klient. Redirect URI musi byt https://trebanam.martinvlcek.sk/api/signin-google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email, ktory po prihlaseni dostane admin prava (Admin__Emails__0).
ADMIN_EMAIL=

# Token pre redeploy webhook - rovnaka hodnota ide do webhook receivera na serveri.
WATCHTOWER_TOKEN=

# Len ked je vlcekmato/trebanam na Docker Hube privatne, inak nechaj prazdne.
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Porty na hostovi. BIND_ADDR nechaj na loopbacku, ked pred tym bezi CF tunel;
# ak cloudflared bezi v inej docker sieti, daj 0.0.0.0 a zavri porty na firewalle.
BIND_ADDR=127.0.0.1
APP_PORT=8080
WATCHTOWER_PORT=8081
