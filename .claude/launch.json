{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "TrebaNam.Client", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "TrebaNam.API"],
      "port": 5000,
      "url": "http://localhost:5000"
    }
  ]
}
